# Redis Simply configuration. Every variable is optional; the defaults are shown.
# Variables set in the real environment (e.g. PHP-FPM env[...]) take precedence
# over this file, and config.php, when present, takes precedence over both.

REDIS_SIMPLY_TITLE="Redis Simply"
# Linked from the signed-out page.
REDIS_SIMPLY_PANEL_URL=

# Connection. Set a socket, or leave it empty to use host and port.
# {target} is replaced by the target named in the sign-on token.
REDIS_SIMPLY_SOCKET=
REDIS_SIMPLY_HOST=127.0.0.1
REDIS_SIMPLY_PORT=6379
REDIS_SIMPLY_TIMEOUT=3
REDIS_SIMPLY_READ_TIMEOUT=30
REDIS_SIMPLY_DATABASES=16

# Sign-on tokens: where the control panel drops them, and how long they last.
REDIS_SIMPLY_TOKEN_DIR=
REDIS_SIMPLY_TOKEN_TTL=60

# Sessions. Leave SESSION_PATH empty to use storage/sessions.
REDIS_SIMPLY_SESSION_PATH=
REDIS_SIMPLY_SESSION_NAME=RedisSimplySession
# Set to false only for local development over plain HTTP.
REDIS_SIMPLY_SESSION_SECURE=true
REDIS_SIMPLY_SESSION_IDLE_TIMEOUT=1800
REDIS_SIMPLY_SESSION_LIFETIME=28800

# Limits.
REDIS_SIMPLY_STRING_PREVIEW=262144
REDIS_SIMPLY_ITEM_PREVIEW=65536
REDIS_SIMPLY_SCAN_PAGE=200
REDIS_SIMPLY_BULK_BUDGET=10
REDIS_SIMPLY_DECODE_SERIALIZED=true
