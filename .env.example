# Redis Admin configuration. Every variable is optional; the defaults are shown.
# Variables set in the real environment (e.g. PHP-FPM env[...]) take precedence
# over this file, and config.php, when present, takes precedence over both.

REDIS_ADMIN_TITLE="Redis Admin"
# Linked from the signed-out page.
REDIS_ADMIN_PANEL_URL=

# Connection. Set a socket, or leave it empty to use host and port.
# {target} is replaced by the target named in the sign-on token.
REDIS_ADMIN_SOCKET=
REDIS_ADMIN_HOST=127.0.0.1
REDIS_ADMIN_PORT=6379
REDIS_ADMIN_TIMEOUT=3
REDIS_ADMIN_READ_TIMEOUT=30
REDIS_ADMIN_DATABASES=16

# Sign-on tokens: where the control panel drops them, and how long they last.
REDIS_ADMIN_TOKEN_DIR=
REDIS_ADMIN_TOKEN_TTL=60

# Sessions. Leave SESSION_PATH empty to use storage/sessions.
REDIS_ADMIN_SESSION_PATH=
REDIS_ADMIN_SESSION_NAME=RedisAdminSession
# Set to false only for local development over plain HTTP.
REDIS_ADMIN_SESSION_SECURE=true
REDIS_ADMIN_SESSION_IDLE_TIMEOUT=1800
REDIS_ADMIN_SESSION_LIFETIME=28800

# Limits.
REDIS_ADMIN_STRING_PREVIEW=262144
REDIS_ADMIN_ITEM_PREVIEW=65536
REDIS_ADMIN_SCAN_PAGE=200
REDIS_ADMIN_BULK_BUDGET=10
REDIS_ADMIN_DECODE_SERIALIZED=true
